# Виртуальное окружение
venv/
.venv/
env/
ENV/

# Конфиденциальные данные и ключи (КРИТИЧЕСКИ ВАЖНО)
.env
*.env
*.pem
*.key

# Базы данных (SQLite для локальных тестов)
*.db
*.sqlite
*.sqlite3

